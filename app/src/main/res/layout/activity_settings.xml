<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Configurações"
            android:textColor="@color/secondary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- API KEY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chave da API (OpenRouter)"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/settings_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="Cole sua chave aqui"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/settings_load_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregar modelos disponíveis"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/settings_model_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha o modelo (toque para selecionar):"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/settings_model_fallback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="ou digite o id do modelo"
                android:background="@drawable/input_background"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <Button
                android:id="@+id/settings_use_fallback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar"
                android:backgroundTint="@color/secondary"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_model_list"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical" />

        <!-- MODO DE USO (perfil global) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo de uso"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/settings_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/settings_mode_iniciante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciante - explica tudo"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_mode_intermediario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intermediário - explica rápido"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_mode_profissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profissional - executa sem ensinar"
                android:textColor="@color/text_primary" />

        </RadioGroup>

        <!-- MODO DO CHAT (Auto / manual) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo do chat"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <RadioGroup
            android:id="@+id/settings_chatmode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/settings_chatmode_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Automático (detecta pelo texto)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_chatmode_aprendiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aprendiz"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_chatmode_intermediario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Intermediário"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_chatmode_profissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profissional"
                android:textColor="@color/text_primary" />

        </RadioGroup>

        <!-- MODO CONFIANTE -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/settings_confident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo Confiante (sem confirmações)"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <!-- MEMÓRIA PERSISTENTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uso da memória persistente"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/settings_memory_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="Prazo em dias (padrão 30)"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/settings_memory_warn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Atenção: ao expirar o prazo, todos os dados salvos (progresso e vulnerabilidades) serão perdidos."
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/settings_clear_dossier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpar Dossiê (memória) agora"
            android:backgroundTint="@color/error_red"
            android:layout_marginTop="8dp" />

        <!-- VOZ -->
        <Button
            android:id="@+id/settings_open_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗣️ Escolher voz da narração"
            android:backgroundTint="@color/primary"
            android:layout_marginTop="8dp" />

        <!-- CÉREBRO / MODO DE AUTONOMIA (Modo 1/2/3) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cérebro (modo de autonomia)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/settings_brain_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/settings_brain_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🖐 Modo 1 - Manual (você opera as ferramentas)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_brain_assist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🤝 Modo 2 - Auxiliador (IA sugere brechas, você decide)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/settings_brain_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Modo 3 - Automático (IA executa tudo e pesquisa na web)"
                android:textColor="@color/text_primary" />

        </RadioGroup>

        <!-- PROMPT COMPLEMENTAR DO USUÁRIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prompt complementar do usuário (opcional - soma à persona Hacker)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/settings_user_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:hint="Ex.: seja ainda mais agressivo na exploração e foque na cadeia de ataque."
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- COMANDOS TERMUX (A1) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Termux (funcionamento pleno)"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COLE OS COMANDOS NA SEQUÊNCIA NO TERMUX PARA A FERRAMENTA TER UM PLENO FUNCIONAMENTO"
            android:textColor="@color/warning_yellow"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/settings_open_termux"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶️ Abrir Termux"
                android:backgroundTint="@color/secondary"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/settings_termux_commands_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 Comandos p/ colar"
                android:backgroundTint="@color/primary"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cole UM comando por vez, na ordem, para o app funcionar. Cada comando tem o botão Copiar."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_termux_commands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settings_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/success_green"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/settings_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar configurações"
            android:backgroundTint="@color/success_green"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>