<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📋 Relatórios"
        android:textColor="@color/secondary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/report_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Título do relatório (ex: Pentest - Cliente X)"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <EditText
        android:id="@+id/report_findings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:gravity="top"
        android:hint="Cole aqui os resultados/vulnerabilidades encontradas (uma por linha)."
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <Button
        android:id="@+id/report_generate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gerar PDF"
        android:backgroundTint="@color/success_green"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/report_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

</LinearLayout>