<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🗣️ Escolha a voz"
        android:textColor="@color/secondary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Carregando vozes..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/voice_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/voice_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/warning_yellow"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/voice_install_google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Instalar Google Text-to-Speech"
        android:backgroundTint="@color/primary"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

</LinearLayout>