<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical">

    <!-- Barra de modo atual -->
    <TextView
        android:id="@+id/chat_mode_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_dark"
        android:padding="6dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!-- Abas de conversação -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversation_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface_dark"
        android:orientation="horizontal" />

    <!-- Mensagens -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Botões de ação rápida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp">

        <Button
            android:id="@+id/quick_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="📶 Wi-Fi"
            android:textSize="12sp"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/quick_blitz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="⚡ Blitz"
            android:textSize="12sp"
            android:backgroundTint="@color/warning_yellow"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/quick_target"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="🌐 Alvo"
            android:textSize="12sp"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/quick_learn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 Aprender"
            android:textSize="12sp"
            android:backgroundTint="@color/success_green" />

    </LinearLayout>

    <!-- Entrada de mensagem -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/voice_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤"
            android:backgroundTint="@color/secondary"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:hint="Digite seu pedido..."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/chat_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Enviar"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

</LinearLayout>