<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📺 IPTV Security Scanner"
        android:textColor="@color/secondary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/iptv_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="IP ou domínio do servidor IPTV"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary" />

    <Button
        android:id="@+id/iptv_check_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checar painel Stalker (porta 8888)"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/iptv_scan_ports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escanear portas"
        android:backgroundTint="@color/secondary"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/iptv_common_creds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Testar credenciais padrão (admin:admin etc.)"
        android:backgroundTint="@color/warning_yellow"
        android:layout_marginTop="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/iptv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_dark"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

</LinearLayout>